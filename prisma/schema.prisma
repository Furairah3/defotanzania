// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model VolunteerApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  interest  String?
  message   String?
  createdAt DateTime @default(now())
}

model DonationIntent {
  id        String   @id @default(cuid())
  name      String
  email     String
  amount    String
  message   String?
  createdAt DateTime @default(now())
}

model NewsPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleSw   String
  excerptEn String
  excerptSw String
  bodyEn    String   @db.Text
  bodySw    String   @db.Text
  date      DateTime @default(now())
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
}

model Publication {
  id        String   @id @default(cuid())
  titleEn   String
  titleSw   String
  type      String
  year      String
  fileUrl   String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  roleEn    String
  roleSw    String
  bioEn     String?
  bioSw     String?
  photoUrl  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model GalleryItem {
  id         String   @id @default(cuid())
  type       String // "photo" | "video"
  captionEn  String
  captionSw  String
  categoryEn String
  categorySw String
  fileUrl    String
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
}

model Project {
  id           String   @id @default(cuid())
  titleEn      String
  titleSw      String
  focusAreaEn  String
  focusAreaSw  String
  status       String
  bodyEn       String
  bodySw       String
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, order])
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String?
  websiteUrl String?
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, order])
}
