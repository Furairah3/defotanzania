# PostgreSQL connection string. Get one free from Supabase (supabase.com) or Neon (neon.tech):
# create a project there, then copy the "connection string" they give you into this value.
#
# On Supabase specifically: this MUST be the "Transaction" pooler connection string
# (port 6543), not "Session" (port 5432) — session mode caps concurrent connections at
# 15 and gets exhausted almost immediately under real serverless traffic on Vercel.
DATABASE_URL="postgresql://user:password@host:6543/database?schema=public"

# Production only: a second connection string used just for running migrations
# (prisma migrate deploy), which needs a session-style connection — the advisory locks
# Prisma takes during migrations aren't reliable through a transaction-mode pooler.
# On Supabase, use the "Session" pooler connection string (port 5432) here.
# Not needed locally — prisma.config.ts falls back to DATABASE_URL when this is unset.
MIGRATE_DATABASE_URL=""

# Password required to sign in to /admin. Use a long, random value in production.
ADMIN_PASSWORD="change-me-before-launch"

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-in-production"

# Optional: enables real photo/logo uploads in the admin panel (Team, Gallery, Partners).
# Without this, uploads are saved locally to /public/uploads for development only —
# fine for testing, but files won't persist on most production hosts.
# Get one free at vercel.com/storage/blob (works even if the site itself isn't hosted on Vercel).
BLOB_READ_WRITE_TOKEN=""
